# Finnhub — get free key at finnhub.io
VITE_FH_API_KEY=your_finnhub_key_here

# Notion — get from notion.so/my-integrations
VITE_NOTION_TOKEN=secret_your_notion_token_here

# Notion Database ID — from your Notion database URL
VITE_NOTION_DATABASE_ID=your_database_id_here

# Supabase — production proxy (replaces Vite proxy in deployed builds)
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
